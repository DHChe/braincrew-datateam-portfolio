{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "es2022"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [{ "name": "next" }]
  },
  "include": [
    "dashboard/**/*.ts",
    "dashboard/**/*.tsx",
    "tests/frontend/**/*.ts",
    "playwright.config.ts",
    "vitest.config.ts",
    "dashboard/.next/types/**/*.ts"
  ],
  "exclude": ["node_modules", "dashboard/out"]
}
